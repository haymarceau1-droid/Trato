# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Solo servidor. NUNCA exponer al cliente (sin prefijo NEXT_PUBLIC_).
# Se usa para: revelar teléfonos a usuarios con sesión, marcar anuncios sospechosos y el seed de demo.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Sitio ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Demo (opcional): muestra "Entrar con la cuenta demo" en /acceder. Úsalo SOLO en entornos de demo. ---
# Debe coincidir con la contraseña que crea supabase/demo.sql (ver README).
# NEXT_PUBLIC_DEMO_PASSWORD=demo-trato-2026

# --- E2E (opcional): usuario de prueba con teléfono/email ya confirmado ---
# E2E_EMAIL=
# E2E_PASSWORD=
